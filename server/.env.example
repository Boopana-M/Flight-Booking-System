# ✅ Copy this file as ".env" and fill your real values

# STEP 1: Server port
PORT=5000

# STEP 2: MongoDB connection (local OR Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/flight_booking_db

# STEP 3: JWT secrets (keep them strong)
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# STEP 4: Frontend URL (for CORS + reset password link)
CLIENT_URL=http://localhost:5173

# STEP 5: Nodemailer (use Mailtrap / Gmail / any SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_mail_user
MAIL_PASS=your_mail_pass
MAIL_FROM="Flight Booking <no-reply@flightbooking.com>"

# STEP 6: Cloudinary (for image/file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# STEP 7: Razorpay (payment)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# STEP 8: Google reCAPTCHA (optional)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret

